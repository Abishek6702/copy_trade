MOCK_ORDER_LATENCY_MS=5
MOCK_ORDER_JITTER_MS=2
DISPATCH_CONCURRENCY=50
BENCHMARK_ITERATIONS=20
LOG_LEVEL=info

# XTS integration settings
BROKER_MODE=mock
XTS_API_KEY=
XTS_API_SECRET=
XTS_API_BASE_URL=
XTS_SOURCE=WEBAPI
XTS_MASTER_USER_ID=
XTS_MASTER_CLIENT_ID=
XTS_AUTO_CONNECT=false
XTS_DETECTION_ONLY=true
LOG_RAW_XTS_EVENTS=false
XTS_RECONNECT_INITIAL_DELAY_MS=1000
XTS_RECONNECT_MAX_DELAY_MS=30000


# test push
WEBHOOK_PORT=3000
GOCHARTING_WEBHOOK_SECRET=change-this-secret
TRADINGVIEW_WEBHOOK_SECRET=change-this-secret
# URL-embedded token for GoCharting (no custom header support).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the full webhook URL in GoCharting as:
#   https://<your-ngrok-host>/webhooks/gocharting/<GOCHARTING_WEBHOOK_TOKEN>
GOCHARTING_WEBHOOK_TOKEN=change-this-token
WEBHOOK_ENABLED=true